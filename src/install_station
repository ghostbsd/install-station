#!/bin/sh
#
# PROVIDE: install_station
# REQUIRE: LOGIN FILESYSTEMS
# BEFORE: lightdm
# KEYWORD: shutdown

. /etc/rc.subr

name="install_station"
rcvar="${name}_enable"
start_cmd="${name}_start"
stop_cmd=":"

install_station_start()
{
    HOME=/root dbus-run-session -- \
        gsettings set org.mate.session required-components-list "['windowmanager']"
    HOME=/root dbus-run-session -- \
        gsettings set org.mate.background show-desktop-icons false

    mkdir -p /root/.install-station-autostart

    cat > /root/.xinitrc <<'EOF'
ck-launch-session mate-session --autostart=/root/.install-station-autostart &
exec install-station
EOF
    chmod 755 /root/.xinitrc

    # Start X as root - this will block until install-station exits
    su -l root -c "startx -- :0 vt09"

    rm -f /root/.xinitrc
    rmdir /root/.install-station-autostart
}

load_rc_config $name
run_rc_command "$1"