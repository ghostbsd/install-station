#!/bin/sh
#
# PROVIDE: install_station
# REQUIRE: LOGIN FILESYSTEMS
# BEFORE: lightdm
# KEYWORD: shutdown

. /etc/rc.subr

name="install_station"
rcvar="${name}_enable"
start_cmd="${name}_start"
stop_cmd=":"

install_station_start()
{
    HOME=/root dbus-run-session -- \
        gsettings set org.mate.background show-desktop-icons false

    cat > /root/.xinitrc <<'EOF'
/usr/local/libexec/mate-settings-daemon &
marco &
exec install-station
EOF
    chmod 755 /root/.xinitrc

    # Start X as root - this will block until install-station exits
    su -l root -c "startx -- :0 vt09"

    rm -f /root/.xinitrc

    HOME=/root dbus-run-session -- \
        gsettings reset org.mate.background show-desktop-icons
}

load_rc_config $name
run_rc_command "$1"